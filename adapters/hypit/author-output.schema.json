    "decisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stopped_before_build": { "type": "boolean" },
    "reference_inspected": { "type": "boolean" }
  }
}
