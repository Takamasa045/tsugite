{
  "name": "tsugite",
  "version": "2.0.0-alpha.5",
  "description": "Human-reviewed, budgeted video workflows — 継手",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tsugite": "bin/tsugite.mjs"
  },
  "files": [
    "bin",
    "src",
    "locales",
    "plugins",
    "packs",
    "skills",
    "docs",
    "knowledge",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node --test tests/*.node.mjs plugins/*/test.mjs",
    "test:offline": "node scripts/offline-smoke.mjs",
    "test:extended": "node scripts/expanded-smoke.mjs",
    "check": "node --check src/core.mjs && node --check src/review.mjs && node --check src/i18n.mjs && node --check src/cli.mjs && node --check src/story.mjs && npm test",
    "security:audit": "node ../scripts/offline-audit.mjs --omit=dev --audit-level=low"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
