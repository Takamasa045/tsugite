{
  "name": "tsugite",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10"
  },
  "bin": {
    "pipeline": "./bin/pipeline"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude=\"apps/**\"",
    "test:coverage": "vitest run --exclude=\"apps/**\" --coverage --coverage.include=\"src/**/*.{ts,mjs}\" --coverage.thresholds.statements=80 --coverage.thresholds.branches=74.4 --coverage.thresholds.functions=80 --coverage.thresholds.lines=80 --maxWorkers=4",
    "pipeline": "node bin/pipeline",
    "setup:check": "node scripts/bootstrap.mjs --check",
    "setup": "node scripts/bootstrap.mjs",
    "setup:open": "node scripts/bootstrap.mjs --open",
    "viewer:dev": "npm --prefix apps/workflow-viewer run dev",
    "viewer:open": "node bin/pipeline viewer-launcher --open",
    "viewer:check": "npm --prefix apps/workflow-viewer run test:coverage && npm --prefix apps/workflow-viewer run typecheck",
    "viewer:build": "npm --prefix apps/workflow-viewer run build",
    "desktop:test": "npm --prefix apps/desktop test",
    "desktop:prepare": "npm --prefix apps/desktop run build:runtime",
    "desktop:package": "npm --prefix apps/desktop run package",
    "desktop:make": "npm --prefix apps/desktop run make",
    "desktop:audit": "npm --prefix apps/desktop run package:audit",
    "security:audit": "npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=moderate",
    "vendor:check": "node scripts/check-vendor-boundary.mjs",
    "postinstall": "node backends/hyperframes/apply-pinned-patches.mjs",
    "check": "npm run vendor:check && npm run build && npm run test:coverage",
    "hyperframes:studio": "node node_modules/hyperframes/bin/hyperframes.mjs preview",
    "hyperframes:studio:verify": "node backends/hyperframes/verify-studio.mjs",
    "pixverse:install": "npm ci --prefix adapters/pixverse/runtime",
    "pixverse": "node adapters/pixverse/cli.mjs",
    "editframe:examples:install": "node scripts/editframe-examples.mjs install",
    "editframe:examples": "node scripts/editframe-examples.mjs start"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@remotion/bundler": "^4.0.512",
    "@remotion/media": "^4.0.512",
    "@remotion/renderer": "^4.0.512",
    "cross-spawn": "^7.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.512",
    "yaml": "^2.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsugite/hyperframes-in-memory-zip": "file:backends/hyperframes/in-memory-zip",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "hyperframes": "0.8.24",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.7",
    "hono": "4.13.7",
    "ip-address": "10.4.0",
    "postcss": "8.5.25",
    "qs": "6.16.0",
    "sharp": "0.35.4",
    "nanoid": "3.3.18",
    "adm-zip": "npm:fflate@0.8.3"
  }
}
