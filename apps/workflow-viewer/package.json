{
  "name": "@tsugite/workflow-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build --configLoader runner",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "test": "vitest run --configLoader runner",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "test:browser": "node --test tests/production-orchestration-browser.test.mjs",
    "preview": "vite preview",
    "security:audit": "node ../../scripts/offline-audit.mjs --audit-level=moderate"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
